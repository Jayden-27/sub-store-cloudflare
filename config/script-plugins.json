      "kind": "operator",
      "compatibility": "free",
      "entry": "script-plugins/client-fingerprint.js",
      "parameters": [
        {
          "key": "fingerprint",
          "label": "Fingerprint",
          "labelZh": "指纹",
          "type": "string",
          "required": true,
          "default": "chrome",
          "placeholder": "chrome"
        },
        {
          "key": "protocols",
          "label": "Protocols",
          "labelZh": "协议",
